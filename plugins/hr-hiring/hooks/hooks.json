{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/ensure_deps.py\" --quiet 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/ensure_deps.py\" --quiet 2>/dev/null || true",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
